APP_NAME=RISK-ERA
APP_ENV=development

# Database — PostgreSQL 17
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database>

# JWT Authentication — set a strong random string in production
JWT_SECRET_KEY=<your-jwt-secret-key>
JWT_SECRET=<your-jwt-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# NVIDIA / Nemotron — AI investigation (required for AI features)
NVIDIA_API_KEY=<your-nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Demo mode — transparent flag to short-circuit Nemotron latency for live presentations
# When true, investigator uses deterministic fallback instantly instead of calling NVIDIA API
# Same functionality as before, but honestly named and documented instead of hidden behind a secret comparison
DEMO_MODE=false

# CORS — comma-separated origins, empty for production
CORS_ORIGINS=

# Optional — Application
# APP_ENV=development  # or production